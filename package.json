{
  "name": "@magzog/magflip",
  "version": "0.5.0",
  "description": "magFlip is a web app that makes it feel like you're flipping through a real book online with smooth page-turning effects.",
  "private": true,
  "author": "Sing Graajae Cho",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:local": "npm run build:local --workspace packages/i18n && npm run build:local --workspace packages/doc && npm run build:local --workspace packages/render && npm run build:local --workspace packages/core && npm run build:local --workspace packages/input && npm run build:local --workspace packages/shelf && npm run build:local --workspace packages/flipview && npm run build:local --workspace packages/scrollview && npm run build:local --workspace packages/minjs",
    "typecheck": "npm run typecheck --ws --if-present",
    "test": "npm test --ws --if-present",
    "serve": "node --env-file-if-exists=.env scripts/serve.mjs",
    "dev": "npm run build:local && npm run serve",
    "build:dev:minjs": "npm run build:dev --workspace packages/minjs",
    "build:dev:watch:minjs": "npm run build:dev:watch --workspace packages/minjs",
    "build:minjs": "npm run build --workspace packages/minjs",
    "build:watch:minjs": "npm run build:watch --workspace packages/minjs",
    "build:core": "npm run build --workspace packages/core",
    "build:i18n": "npm run build --workspace packages/i18n",
    "build:doc": "npm run build --workspace packages/doc",
    "build:render": "npm run build --workspace packages/render",
    "build:watch:core": "npm run build:watch --workspace packages/core",
    "build:watch:i18n": "npm run build:watch --workspace packages/i18n",
    "build:watch:doc": "npm run build:watch --workspace packages/doc",
    "build:watch:render": "npm run build:watch --workspace packages/render",
    "build:input": "npm run build --workspace packages/input",
    "build:watch:input": "npm run build:watch --workspace packages/input",
    "build:flipview": "npm run build --workspace packages/flipview",
    "build:watch:flipview": "npm run build:watch --workspace packages/flipview",
    "build:scrollview": "npm run build --workspace packages/scrollview",
    "build:watch:scrollview": "npm run build:watch --workspace packages/scrollview",
    "build": "npm run build --ws --if-present",
    "versionup:minor": "npm version minor --git-tag-version",
    "pub": "npm run pub --ws --if-present --otp $npm_config_otp",
    "sample:book": "node scripts/make-sample-book.mjs"
  }
}
